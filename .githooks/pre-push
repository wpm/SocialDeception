#!/usr/bin/env bash
# Pre-push hook: the same checks CI runs, so a push that passes here is very
# unlikely to fail there. Running at push time rather than on every commit
# keeps the full suite off the path of each individual commit, and a push
# that publishes no commits skips the suite entirely.
#
# Wire it up once per clone with:
#
#     git config core.hooksPath .githooks
#
# The four cargo checks are mandatory. cargo-deny and typos run when
# installed; when they are not, the hook says so and CI still enforces them.

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Git describes the push on stdin, one line per ref:
#
#     <local ref> <local sha> <remote ref> <remote sha>
#
# Two shapes mean nothing is being published. No lines at all is an
# up-to-date push, and an all-zero local sha is a branch deletion. Neither
# puts new commits on the remote, so the suite would have nothing to say
# about them. Anything else is real work arriving and earns the full run.
publishes_commits() {
    local local_ref local_sha remote_ref remote_sha
    while read -r local_ref local_sha remote_ref remote_sha; do
        [ -n "${local_sha:-}" ] || continue
        case "$local_sha" in
            *[!0]*) return 0 ;;
        esac
    done
    return 1
}

if ! publishes_commits; then
    printf 'Nothing to push; skipping the pre-push checks.\n'
    exit 0
fi

step() {
    printf '\n==> %s\n' "$*"
}

step "cargo fmt --check"
cargo fmt --check

step "cargo clippy --all-targets -- -D warnings"
cargo clippy --all-targets -- -D warnings

step "cargo test"
cargo test

# Private items are documented heavily here, and a broken or redundant
# intra-doc link among them is an error that a plain `cargo doc` never
# reaches. `-D warnings` keeps a rustdoc lint from passing as a warning.
step "cargo doc --document-private-items"
RUSTDOCFLAGS="-D warnings" cargo doc --workspace --no-deps --document-private-items

if cargo deny --version >/dev/null 2>&1; then
    step "cargo deny check"
    cargo deny check
else
    printf '\n!! cargo-deny is not installed; skipping. CI runs it.\n'
    printf '   Install with: cargo install --locked cargo-deny\n'
fi

if command -v typos >/dev/null 2>&1; then
    step "typos"
    typos
else
    printf '\n!! typos is not installed; skipping. CI runs it.\n'
    printf '   Install with: cargo install --locked typos-cli\n'
fi

printf '\nAll pre-push checks passed.\n'
